# ═══════════════════════════════════════════════════════
#   ReachPilot — copy this file to .env and fill it in
#   (edit .env, then restart the server)
# ═══════════════════════════════════════════════════════

# ── Gmail (required for LIVE sends) ────────────────────
GMAIL_ID=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── Groq AI (optional — per-JD resume tailoring) ───────
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# ── Engine ──────────────────────────────────────────────
# Every run is live: real Chromium + real LinkedIn + real Gmail sends.
# Chromium persistent profile dir — stores your LinkedIn login (gitignored)
LINKEDIN_PROFILE_DIR=linkedin_saved_login
# First run only: seconds to wait for a manual LinkedIn sign-in in the opened window
LINKEDIN_LOGIN_WAIT_SEC=300
# Server without a display? Set:
# SCRAPER_HEADLESS=1
# Never fall back to the embedded in-memory MongoDB? Set:
# MONGODB_DISABLE_EMBEDDED=1

# ── Database ────────────────────────────────────────────
# MONGODB_URI=mongodb://127.0.0.1:27017
# MONGODB_DB=reachpilot

# ── Candidate profile (subject line, email body, resume) ─
CANDIDATE_NAME=Rudraksh Gogineni
CANDIDATE_EMAIL=goginenirudraksh005@gmail.com
CANDIDATE_PHONE=+1 443-514-9269
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/rudraksh-gogineni-1a8470346
CANDIDATE_LOCATION=San Francisco, CA
CANDIDATE_RELOCATION=Yes (California Preferred)
CANDIDATE_WORK_AUTH=STEM OPT
CANDIDATE_AVAILABILITY=Immediate
CANDIDATE_EXPERIENCE=2+ Years
CANDIDATE_EXPECTED_RATE=Negotiable

# ── Optional routing & tuning ───────────────────────────
# CC_EMAILS=a@x.com b@y.com
# BCC_EMAILS=c@z.com
# MAX_EMAILS_PER_ROLE=15
# DELAY_BETWEEN_EMAILS=12
# SCROLL_ROUNDS=8
# WAIT_BETWEEN_ROLES_MIN=60
# WAIT_BETWEEN_ROLES_MAX=120
# DAILY_RESPONSE_TARGET=20
# RESUME_FILENAME=Resume.pdf
